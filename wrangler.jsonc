{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tad",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Statik frontend (public/) — /api/* so'rovlari Worker'ga boradi, qolganlari SPA
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // D1 ma'lumotlar bazasi. database_id ko'rsatilmagan: birinchi `wrangler deploy`da
  // Cloudflare bazani avtomatik yaratadi. Jadvallar Worker'ning birinchi so'rovida
  // avtomatik yaratiladi (src/lib/schema.js).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tad-db",
      "migrations_dir": "migrations"
    }
  ],

  // migrations/*.sql fayllarini Worker ichiga matn sifatida qo'shish
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // Cloudflare Workers AI — baholash, tavsiyalar va AI-yordamchi uchun
  "ai": { "binding": "AI" },

  "vars": {
    "APP_NAME": "TAD Ta'lim platformasi",
    "APP_TAGLINE": "«Tadbirkorlik asoslari» fanini amaliy o'zlashtirish platformasi: g'oyadan biznes-reja himoyasigacha",
    // Birinchi administrator ro'yxatdan o'tganda avtomatik yuklanadigan kurs (src/data/catalog.js)
    "DEFAULT_COURSE": "tadbirkorlik-asoslari",
    // Workers AI modeli (ANTHROPIC_API_KEY berilmagan bo'lsa ishlatiladi)
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // ANTHROPIC_API_KEY maxfiy kaliti o'rnatilsa, shu Claude modeli ishlatiladi
    "CLAUDE_MODEL": "claude-sonnet-5-5"
  }
}
